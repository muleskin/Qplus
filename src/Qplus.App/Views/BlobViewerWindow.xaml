<Window x:Class="Qplus.App.Views.BlobViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Binary value" Height="580" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Panel}"
        Foreground="{DynamicResource Brush.Text}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText" Margin="2,0,2,8"
                   FontSize="13" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Text}"/>

        <TabControl Grid.Row="1" x:Name="Tabs"
                    Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Border}">
            <TabItem Header="Hex / ASCII">
                <TextBox x:Name="HexBox" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="12"
                         Background="{DynamicResource Brush.EditorBg}"
                         Foreground="{DynamicResource Brush.EditorText}"
                         BorderThickness="0"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" AcceptsReturn="True"/>
            </TabItem>
            <TabItem x:Name="ImageTab" Header="Image">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="{DynamicResource Brush.GridBg}">
                    <Image x:Name="ImageView" Stretch="None" Margin="8"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save as…" Width="100" Padding="0,4" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="Close" Width="90" Padding="0,4" Click="Close_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
